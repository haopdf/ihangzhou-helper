# iHangzhou AI 助手环境变量
# 复制本文件为 .env.local 用于本地开发；Vercel 上请在 Project Settings → Environment Variables 配置
#
# 阿里云百炼（DashScope）API Key
# 申请：https://bailian.console.aliyun.com/ → 模型广场 → API-KEY 管理
# 模型默认使用 qwen-turbo（性价比高），可在 api/chat.js 调整为 qwen-plus / qwen-max
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
