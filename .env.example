# iHangzhou 环境变量
# 复制本文件为 .env.local 用于本地开发；Vercel 上在 Project Settings → Environment Variables 配置
# 详细说明见 CONTRIBUTING.md 第 3 节

# ========== 微信公众号 ==========
# 公众号签名验证 Token（公众号后台 → 服务器配置 → Token）
# 生产环境务必设置为随机字符串；未配置时微信回调签名校验一律不通过
WECHAT_TOKEN=

# 公众号 AppID / AppSecret（菜单同步用，公众号后台 → 基本配置）
# 订阅号若无菜单 API 权限（48001），可不配
WX_APPID=
WX_SECRET=

# ========== AI 对话 ==========
# 阿里云百炼（DashScope）API Key
# 申请：https://bailian.console.aliyun.com/ → 模型广场 → API-KEY 管理
# 模型默认 qwen-turbo，可在 api/chat.js 调整为 qwen-plus / qwen-max
DASHSCOPE_API_KEY=

# ========== Vercel Blob 存储 ==========
# 关键词数据、反馈数据等独立存储，避免读全量 CMS 数据
# 获取：Vercel Dashboard → 项目 → Storage → Create Blob Store → 生成 Read/Write Token
BLOB_READ_WRITE_TOKEN=

# ========== 管理后台 ==========
# /admin 页面访问密码（api/* 写接口鉴权统一使用）
# 必须设置为高强度随机字符串；未配置时所有管理写操作直接拒绝
CMS_ADMIN_PASSWORD=
