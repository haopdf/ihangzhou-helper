# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/

# Secrets / tokens
.gitee
.env
.token

# Test files (keep them but ignore temp)
*.log
.vercel

.env*

# UI QA 截图（本地归档用，不入库）
docs/ui-review/
.env*.local

# 文章 API 本地兜底存储（无 Blob token 时 dev 写入，不入库）
data/.articles/

# 开发环境污染（浏览器/IDE 缓存，不入库不部署）
edge-profile/
.trae/
trash/
obsolete/

# 生成物（部署时由 build 脚本重新生成）
# sitemap.xml 由 gen-sitemap.js 生成，但随仓库收录与更新（供搜索引擎与部署前预检）
# articles/search-index.json <- build-search-index.js
# lib/articles-index.data.js <- build-index-data.mjs（api/articles-index.js 的数据包）
articles/search-index.json
lib/articles-index.data.js

# 压缩产物（build-assets.mjs 生成，源文件保留在 js/ css/）
js/*.min.js
css/*.min.css

# 构建生成物（build-home-cats.mjs 从 js/cat-data.js 派生）
js/home-cats.js

# 构建脚本/文档/源数据：开发需要但不进部署包（避免超 Vercel 100MB 上限）
scripts/
docs/
data/*
# 例外：place.html 运行时硬依赖，必须入库、随部署下发
!data/places.json

# 本地 Playwright CLI 调试产物
.playwright-cli/
